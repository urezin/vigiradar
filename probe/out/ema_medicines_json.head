            "name_of_medicine": "Idacio",
            "ema_product_number": "EMEA/H/C/004475",
            "medicine_status": "Authorised",
            "opinion_status": "",
            "latest_procedure_affecting_product_information": "VR/0000360787",
            "international_non_proprietary_name_common_name": "adalimumab",
            "active_substance": "adalimumab",
            "therapeutic_area_mesh": "Arthritis, Rheumatoid;Arthritis, Psoriatic;Psoriasis;Spondylitis, Ankylosing;Uveitis;Hidradenitis Suppurativa;Colitis, Ulcerative;Crohn Disease;Arthritis, Juvenile Rheumatoid",
            "species_veterinary": "",
