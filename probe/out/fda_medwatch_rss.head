    <dc:creator>FDA</dc:creator>
    <guid isPermaLink="true">http://www.fda.gov/medical-devices/medical-device-recalls-and-early-alerts/hospital-glucose-meter-removal-nova-biomedical-removes-statstrip-glucose-hospital-meter-systems</guid>
    </item>
<item>
  <title>Diagnostic Ultrasound System Correction: Philips Ultrasound Issues Updated Use Instructions for Lumify Diagnostic Ultrasound System</title>
  <link>http://www.fda.gov/medical-devices/medical-device-recalls-and-early-alerts/diagnostic-ultrasound-system-correction-philips-ultrasound-issues-updated-use-instructions-lumify</link>
  <description>A software app or transducer connection problem with the Philips Lumify diagnostic ultrasound system can result in loss of or delays in scanning functionality.</description>
  <pubDate>Mon, 19 Oct 2026 00:00:00 EDT</pubDate>
    <dc:creator>FDA</dc:creator>
    <guid isPermaLink="true">http://www.fda.gov/medical-devices/medical-device-recalls-and-early-alerts/diagnostic-ultrasound-system-correction-philips-ultrasound-issues-updated-use-instructions-lumify</guid>
    </item>
